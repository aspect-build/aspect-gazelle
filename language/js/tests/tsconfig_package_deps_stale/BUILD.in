load("@aspect_rules_js//js:defs.bzl", "js_library")

# Validates removal of package.json js_library targets that are no longer needed:
# - Root: the directive is disabled, so the generated 'package_json' library
#   is removed. 'keep' is hand-written (its name does not match the
#   package.json it holds), so it MUST survive.
# - unused/: the directive is enabled, but no Bazel package below needs its
#   package.json, so its 'package_json' library is removed.

js_library(
    name = "package_json",
    srcs = ["package.json"],
    visibility = [":__subpackages__"],
)

js_library(
    name = "keep",
    srcs = ["package.json"],
)
