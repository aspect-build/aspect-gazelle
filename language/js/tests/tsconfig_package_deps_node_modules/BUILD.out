load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

# Gazelle runs only on the root (see arguments.txt). The only BUILD file that
# depends on //:package_json is under node_modules/, which the search for
# unregenerated users skips, so the root MUST NOT generate the library.

# gazelle:js_tsconfig_package_deps enabled

ts_project(
    name = "tsconfig_package_deps_node_modules",
    srcs = ["main.ts"],
    tsconfig = ":tsconfig",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
    deps = [":package.json"],
)
