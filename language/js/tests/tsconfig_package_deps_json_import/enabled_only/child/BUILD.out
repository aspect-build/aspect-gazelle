load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

ts_project(
    name = "child",
    srcs = ["main.ts"],
    resolve_json_module = True,
    tsconfig = ":tsconfig",
    deps = ["//enabled_only:package_json"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
    deps = ["//enabled_only:package_json"],
)
