load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//tools:vitest.bzl", "vitest_ts_project")

# This child overrides the root's inherited test-group mapping. The library
# remains plain while the test group uses the child macro.
# gazelle:map_kind ts_project:{dirname}_tests vitest_ts_project //tools:vitest.bzl
# gazelle:alias_kind vitest_ts_project ts_project

ts_project(
    name = "override",
    srcs = ["lib.ts"],
)

vitest_ts_project(
    name = "override_tests",
    testonly = True,
    srcs = ["lib.spec.ts"],
    deps = [":override"],
)
