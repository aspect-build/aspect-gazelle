load("//tools:jest.bzl", "combo_jest_project")
load("//tools:kinds.bzl", "my_ts_project")

# The tests macro wraps the plain-mapped kind; its alias defaults to my_ts_project.
# gazelle:map_kind ts_project my_ts_project //tools:kinds.bzl
# gazelle:map_kind ts_project:{dirname}_tests combo_jest_project //tools:jest.bzl

my_ts_project(
    name = "combo",
    srcs = ["app.ts"],
)

combo_jest_project(
    name = "combo_tests",
    testonly = True,
    srcs = ["app.spec.ts"],
    deps = [":combo"],
)
