load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

# Validates which descendants make an ancestor generate its package.json js_library:
# - no-tsconfig/ emits no ts_config, so it does not need //:package_json.
# - own-pkg/ has its own package.json, which hides the root one from it and
#   from everything below it. So the root generates no library.
# - own-pkg/inner/ has a tsconfig.json and resolves to own-pkg/package.json, so
#   own-pkg generates one and inner depends on it.

# gazelle:js_tsconfig_package_deps enabled

ts_project(
    name = "tsconfig_package_deps_needed",
    srcs = ["main.ts"],
    tsconfig = ":tsconfig",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
    deps = [":package.json"],
)
