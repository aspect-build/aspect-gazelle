load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

# 'child' has no BUILD file yet, so gazelle creates it in this run. Gazelle
# generates child before root, so root learns that child depends on its
# package.json and generates the 'package_json' js_library for it.

# gazelle:js_tsconfig_package_deps enabled

ts_project(
    name = "tsconfig_package_deps_create",
    srcs = ["main.ts"],
    tsconfig = ":tsconfig",
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
    visibility = [":__subpackages__"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
    deps = [":package.json"],
)
