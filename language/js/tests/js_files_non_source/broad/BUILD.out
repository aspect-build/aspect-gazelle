load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# A glob is taken at face value: `**/*` collects every walked file, including
# Bazel's own build definition files. Use `gazelle:exclude` to opt files out
# (see ../broad_exclude).
# gazelle:js_files everything **/*

ts_project(
    name = "everything",
    srcs = ["b.ts"],
    assets = [
        "BUILD.bazel",
        "data.yml",
        "defs.bzl",
    ],
)
