aspect.gazelle_rule_kind("x_lib", {
    "From": "@deps-test//my:rules.bzl",
})

def declare(ctx):
    ctx.targets.add(
        name = "lib",
        kind = "x_lib",
        attrs = {
            "srcs": aspect.Glob(["*.java"]),
        },
    )

aspect.orion_extension(
    id = "glob-non-mergeable-test",
    declare = declare,
)
