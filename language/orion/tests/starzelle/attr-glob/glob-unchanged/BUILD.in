load("@rules_java//java:defs.bzl", "java_library")

# gazelle:java_glob_allow_empty true

java_library(
    name = "lib",
    srcs = glob(
        [
            # Every source in the package.
            "*.java",
            "*.kt",
        ],
        exclude = ["*Test.java"],
        allow_empty = True,
    ),
)
