# A main-repository plugin loading shared helpers from an external repository.
load("@orion_test_plugins//:lib/util.star", "make_target_name")

def _prepare(_):
    return aspect.PrepareResult(
        sources = [
            aspect.SourceGlobs("**/*.md"),
        ],
    )

def _declare_targets(ctx):
    if len(ctx.sources) == 0:
        return

    ctx.targets.add(
        name = make_target_name("local"),
        kind = "filegroup",
        attrs = {
            "srcs": [s.path for s in ctx.sources],
        },
    )

aspect.orion_extension(
    id = "local-plugin",
    prepare = _prepare,
    declare = _declare_targets,
)
