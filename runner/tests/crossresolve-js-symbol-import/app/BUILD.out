load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("//bazel:defs.bzl", "ts_tree")

ts_project(
    name = "app",
    srcs = ["index.ts"],
    tsconfig = ":tsconfig",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
)

ts_tree(
    name = "ts_tree",
    deps = [
        ":app",
        "//app/lib",
        "//app/lib:lib_tests",
        "//app/util",
    ],
)
